# Copy to .env and fill in. Never commit .env.

# Telegram bot token from @BotFather (backend and bot both need it)
BOT_TOKEN=
# Telegram user ids of the Super Admins, comma separated
SUPER_ADMIN_IDS=

# Public address. docker-compose.yml serves the Web App at https://DOMAIN and the bot's webhook at
# https://DOMAIN/telegram
DOMAIN=bot-doppi.example.com
# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels). The tunnel's public hostname for DOMAIN
# must point to the service http://app:8000
TUNNEL_TOKEN=

# UseMinute partner-portal login (the same values the Camera Assignment Bot calls MINUTE_*). Empty: no sync
DOPPI_API_KEY=
DOPPI_REFRESH_TOKEN=
DOPPI_ORG=

# Email sender for verification codes. Workers can't link a UseMinute account without it
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (587), ssl (465) or none
SMTP_SECURITY=starttls
# The sender address, e.g. no-reply@example.com ("Name <address>" works too; the email shows the bot's name)
SMTP_FROM=
